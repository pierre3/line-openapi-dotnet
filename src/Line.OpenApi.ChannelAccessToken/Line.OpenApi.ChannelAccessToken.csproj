<Project Sdk="Microsoft.NET.Sdk">
  <!-- channel-access-token.yml 生成クライアント + 更新型トークンプロバイダの置き場所。
       （更新型プロバイダを Core でなくここに置くことで Core→ChannelAccessToken の逆依存を回避） -->
  <PropertyGroup>
    <Description>LINE channel access token issuance for .NET (v2.1 JWT assertion and v3 stateless tokens) with a refreshing token provider. Part of the Line.OpenApi client libraries generated from the official LINE OpenAPI specs with Kiota.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="$(KiotaBundleVersion)" />
    <ProjectReference Include="..\Line.OpenApi.Core\Line.OpenApi.Core.csproj" />
  </ItemGroup>
</Project>
