<Project Sdk="Microsoft.NET.Sdk">
  <!-- shop.yml。単一ホスト(api.line.me)。ファサード ShopClient でミッションスタンプ送信を提供する。 -->
  <PropertyGroup>
    <Description>LINE Shop mission sticker client for .NET (ShopClient facade: send mission stickers). Part of the Line.OpenApi client libraries generated from the official LINE OpenAPI spec with Kiota.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="$(KiotaBundleVersion)" />
    <!-- DI 統合: IHttpClientFactory / 名前付き HttpClient / Options -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <ProjectReference Include="..\Line.OpenApi.Core\Line.OpenApi.Core.csproj" />
  </ItemGroup>
</Project>
