<Project Sdk="Microsoft.NET.Sdk">
  <!-- insight.yml。単一ホスト(api.line.me)。ファサード InsightClient で統計・分析
       （友だち属性・配信数・フォロワー数・開封/クリック・リッチメニュー統計）を提供する。 -->
  <PropertyGroup>
    <Description>LINE Insight (statistics) client for .NET (InsightClient facade: friend demographics, message deliveries, followers, message events, per-unit statistics, rich menu insights). Part of the Line.OpenApi client libraries generated from the official LINE OpenAPI spec with Kiota.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="$(KiotaBundleVersion)" />
    <!-- DI 統合: IHttpClientFactory / 名前付き HttpClient / Options -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <ProjectReference Include="..\Line.OpenApi.Core\Line.OpenApi.Core.csproj" />
  </ItemGroup>
</Project>
