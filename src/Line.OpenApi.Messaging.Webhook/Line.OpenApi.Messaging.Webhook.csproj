<Project Sdk="Microsoft.NET.Sdk">
  <!-- webhook.yml のモデル＋受信グルー（WebhookRequestParser: 署名検証＋逆直列化）。署名検証は Line.OpenApi.Core。 -->
  <PropertyGroup>
    <Description>LINE webhook models and a receive helper for .NET (WebhookRequestParser: signature validation plus payload deserialization). Part of the Line.OpenApi client libraries generated from the official LINE OpenAPI spec with Kiota.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="$(KiotaBundleVersion)" />
    <!-- 受信ヘルパが JsonParseNodeFactory を直接使う（既定レジストリ非依存）ため明示参照。
         Bundle 経由でも推移的に入るが、直接依存を明示する。 -->
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="$(KiotaBundleVersion)" />
    <!-- DI 統合（HTTP 送信なしのため IHttpClientFactory は不要。Options のみ）。 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <ProjectReference Include="..\Line.OpenApi.Core\Line.OpenApi.Core.csproj" />
  </ItemGroup>
</Project>
