<Project Sdk="Microsoft.NET.Sdk">
  <!-- module.yml。単一ホスト(api.line.me)。ファサード ModuleClient でモジュールチャネル
       （detach / chat control acquire・release / attach 済み bot 一覧）を提供する。
       注意: module-attach.yml（manager.line.biz / Basic 認証 / form+PKCE）は今回未取り込み。 -->
  <PropertyGroup>
    <Description>LINE Module channel client for .NET (ModuleClient facade: detach, acquire/release chat control, list attached modules). Part of the Line.OpenApi client libraries generated from the official LINE OpenAPI spec with Kiota.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="$(KiotaBundleVersion)" />
    <!-- DI 統合: IHttpClientFactory / 名前付き HttpClient / Options -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <ProjectReference Include="..\Line.OpenApi.Core\Line.OpenApi.Core.csproj" />
  </ItemGroup>
</Project>
