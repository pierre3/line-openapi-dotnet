<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- テストは net10.0（ライブラリと同一 TFM） -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- PublicApiSnapshotTests は [CallerFilePath] でスナップショット置き場を実行時に特定する。
         CI では Directory.Build.props が ContinuousIntegrationBuild=true にし SourceLink の
         決定的ソースパスが有効化され、[CallerFilePath] が実パスでなく "/_/..." を返すため
         Directory.CreateDirectory / File アクセスが Permission denied で失敗する。
         テストは非パック（決定的ビルド不要）なので、このプロジェクトだけ remap を無効化して
         実パスを返させる。 -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- 公開 API 表面の snapshot 生成（G4②・設計 §8）。手書き表面のみ対象、Generated は除外。 -->
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Line.OpenApi.Core\Line.OpenApi.Core.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.ChannelAccessToken\Line.OpenApi.ChannelAccessToken.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Messaging\Line.OpenApi.Messaging.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Messaging.Webhook\Line.OpenApi.Messaging.Webhook.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Liff\Line.OpenApi.Liff.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Login\Line.OpenApi.Login.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Insight\Line.OpenApi.Insight.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Module\Line.OpenApi.Module.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Shop\Line.OpenApi.Shop.csproj" />
  </ItemGroup>
</Project>
