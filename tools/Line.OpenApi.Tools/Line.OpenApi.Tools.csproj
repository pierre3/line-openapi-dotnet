<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Line.OpenApi.Tools</RootNamespace>
    <AssemblyName>Line.OpenApi.Tools</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Distributed as a .NET global tool: `dotnet tool install -g Line.OpenApi.Tools`
         then invoked as `line`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>line</ToolCommandName>
    <Description>Local CLI and MCP tool for the LINE Platform, built on the Line.OpenApi client libraries. Exposes token management, message send / bot lookup, webhook development helpers, and LIFF management both as CLI subcommands and as MCP server tools.</Description>

    <!-- Independent release cadence from the library packages (spec §7):
         the tool depends on evolving tooling and is versioned/tagged (cli-v*) on its own. -->
    <Version>1.0.0</Version>

    <!-- Application, not public API surface: no XML doc file. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Ship the tool-specific README on NuGet instead of the repository-root library README.
         PackRootReadme=false opts out of the root README include in Directory.Build.props. -->
    <PackRootReadme>false</PackRootReadme>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The tool is released on its own cadence (tag tools-v*), so it is excluded from the
       library pack/verify workflows (pack-verify smoke test and the `v*` library release)
       via -p:ExcludeToolFromPack=true. Its own release path packs this project directly. -->
  <PropertyGroup Condition="'$(ExcludeToolFromPack)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tool-specific package README (tools/README.md, English). -->
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Line.OpenApi.Bot bundles Messaging + Messaging.Webhook + ChannelAccessToken.
         Liff is referenced separately (not part of the Bot meta-package). -->
    <ProjectReference Include="..\..\src\Line.OpenApi.Bot\Line.OpenApi.Bot.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Liff\Line.OpenApi.Liff.csproj" />
    <!-- Coverage packages surfaced by the insight / audience / shop command groups. -->
    <ProjectReference Include="..\..\src\Line.OpenApi.Insight\Line.OpenApi.Insight.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.ManageAudience\Line.OpenApi.ManageAudience.csproj" />
    <ProjectReference Include="..\..\src\Line.OpenApi.Shop\Line.OpenApi.Shop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Line.OpenApi.Tools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cocona" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- Reads the embedded messaging-api.yml at runtime (MessageSchemaService / line_message_schema). -->
    <PackageReference Include="SharpYaml" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the repository's canonical messaging-api.yml (the same spec Kiota generates from,
         so the extracted JSON Schema never drifts from the models). Single source of truth: it is
         refreshed by scripts/generate.ps1 / generate.sh. LogicalName is fixed because the file
         lives outside the project cone. Consumed by Services/MessageSchemaService.cs. -->
    <EmbeddedResource Include="..\..\openapi\messaging-api.yml">
      <LogicalName>Line.OpenApi.Tools.messaging-api.yml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
