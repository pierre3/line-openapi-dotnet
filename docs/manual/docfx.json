{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../..",
          "files": [
            "src/Line.OpenApi.Core/Line.OpenApi.Core.csproj",
            "src/Line.OpenApi.ChannelAccessToken/Line.OpenApi.ChannelAccessToken.csproj",
            "src/Line.OpenApi.Messaging/Line.OpenApi.Messaging.csproj",
            "src/Line.OpenApi.Messaging.Webhook/Line.OpenApi.Messaging.Webhook.csproj",
            "src/Line.OpenApi.Liff/Line.OpenApi.Liff.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "disableGitFeatures": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "en/**.md", "en/**/toc.yml" ] },
      { "files": [ "ja/**.md", "ja/**/toc.yml" ] },
      { "files": [ "toc.yml", "index.md" ] }
    ],
    "resource": [
      { "files": [ "images/**" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "LINE .NET Client",
      "_appTitle": "LINE .NET Client Library",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
